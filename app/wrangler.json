{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devhub-app",
  "compatibility_date": "2026-08-21",
  "main": "./src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "SUGA_ORIGIN": "https://51vjnl29rmug-production-2c2y9lr8.us-central1.suga.run"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
