DATABASE_URL=postgres://devhub:devhub@localhost:5432/devhub
DATABASE_URL_TEST=postgres://devhub:devhub@localhost:5433/devhub_test
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
PORT=3000
# Max pg pool connections (lower on memory-constrained hosts, e.g. 6 on Suga free)
PG_POOL_MAX=20
NODE_ENV=development
COOKIE_SECURE=false
# Comma-separated allowed origins for CORS (empty = same-origin only)
CORS_ORIGIN=
# Billing Pakasir (ADR-044) — checkout QRIS/VA per workspace
PAKASIR_ENABLED=false
PAKASIR_SANDBOX=true
# Slug + API Key dari detail Proyek di dashboard Pakasir
PAKASIR_SLUG=
PAKASIR_API_KEY=
# URL publik aplikasi (untuk redirect kembali setelah bayar)
APP_PUBLIC_URL=
