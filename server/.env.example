DATABASE_URL=postgres://devhub:devhub@localhost:5432/devhub
DATABASE_URL_TEST=postgres://devhub:devhub@localhost:5433/devhub_test
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
PORT=3000
# Max pg pool connections (lower on memory-constrained hosts, e.g. 6 on Suga free)
PG_POOL_MAX=20
NODE_ENV=development
COOKIE_SECURE=false
# Trust proxy (required behind reverse proxy e.g. Cloudflare Worker + Suga for OAuth discovery to return public origin)
TRUST_PROXY=false
# Comma-separated allowed origins for CORS (empty = same-origin only)
CORS_ORIGIN=
# Parent domain for the session cookie — single login covers app + admin
# subdomains (ADR-051). Empty = host-only cookie (local dev). Prod (Suga):
# COOKIE_DOMAIN=.nrawangbatin.my.id — the Worker proxy preserves it (worker.ts).
COOKIE_DOMAIN=
# Billing Pakasir (ADR-044) — checkout QRIS/VA per workspace
# PROD Suga checklist (nilai asli HANYA di dashboard Suga, JANGAN commit):
#   PAKASIR_SANDBOX=false
#   PAKASIR_SLUG + PAKASIR_API_KEY prod (tandai Sensitive di Suga)
#   APP_PUBLIC_URL=https://devhub.nrawangbatin.my.id
#   COOKIE_SECURE=true, TRUST_PROXY=true, PG_POOL_MAX=6, CORS_ORIGIN=(kosong = same-origin)
#   COOKIE_DOMAIN=.nrawangbatin.my.id (single session app + admin, ADR-051)
#   Webhook Pakasir → https://devhub.nrawangbatin.my.id/api/v1/billing/webhook
#   Pricing seed: psql "$DATABASE_URL" -f server/src/db/seeds/001_pro_pricing_2026-09-13.sql
PAKASIR_ENABLED=true
PAKASIR_SANDBOX=true
# Slug + API Key dari detail Proyek di dashboard Pakasir
PAKASIR_SLUG=devhub
PAKASIR_API_KEY=your-pakasir-api-key-here
# URL publik aplikasi (untuk redirect kembali setelah bayar)
APP_PUBLIC_URL=http://localhost:5173
# OAuth social login — keep email+password, additive (030). Isi keduanya untuk aktifkan tombol di AuthPage.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Extra redirect origins untuk OAuth callback (preview deploys), comma-separated
OAUTH_REDIRECT_ORIGINS=
