DATABASE_URL=postgres://devhub:devhub@localhost:5432/devhub
DATABASE_URL_TEST=postgres://devhub:devhub@localhost:5433/devhub_test
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
PORT=3000
# Max pg pool connections (lower on memory-constrained hosts, e.g. 6 on Suga free)
PG_POOL_MAX=20
NODE_ENV=development
COOKIE_SECURE=false
# Comma-separated allowed origins for CORS (empty = same-origin only)
CORS_ORIGIN=
